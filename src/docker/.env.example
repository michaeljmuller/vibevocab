# VibeVocab environment configuration
# Copy this file to .env and fill in your values.
# Variables with defaults shown can be omitted to use the default.


# --- Database ---
# These defaults work fine for local development.
# POSTGRES_DB=vibevocab
# POSTGRES_USER=vibevocab
# POSTGRES_PASSWORD=vibevocab


# --- Authentication ---
# Option A (simpler): single-user mode — set your email, skip Google OAuth.
SINGLE_USER=

# Used with Option B: email pre-created in the DB on first startup, ensuring
# the account exists before the first OAuth login attempt.
BOOTSTRAP_USER=

# Option B: Google OAuth for multi-user mode.
# Create credentials at https://console.cloud.google.com/ (OAuth 2.0 client ID,
# type "Web application", redirect URI http://localhost:5001/auth/callback).
# Leave SINGLE_USER blank if using this option.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Flask session signing key. Default is insecure; set a random value for any
# shared or production deployment.
# SECRET_KEY=dev-secret-key


# --- LLM (AI-generated example sentences and translations) ---
# LLM_PROVIDER options: anthropic, openai-compatible
# For local Ollama (no API key): set LLM_PROVIDER=openai-compatible,
#   LLM_BASE_URL=http://host.docker.internal:11434/v1, LLM_MODEL=<model-name>
LLM_PROVIDER=openai-compatible
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
# LLM_BASE_URL=         # required for openai-compatible non-OpenAI endpoints
# SUGGESTION_COUNT=3


# --- TTS (ElevenLabs audio) ---
# Leave blank to disable audio generation.
# Find voice IDs at https://elevenlabs.io/voice-library
ELEVENLABS_API_KEY=
TTS_VOICE_ID=
# TTS_MODEL=eleven_multilingual_v2
# TTS_SPEED=1.0
# TTS_STABILITY=0.48
# TTS_SIMILARITY=0.75
# TTS_STYLE=0.08
# TTS_SPEAKER_BOOST=true


# --- UI tuning ---
# CARD_FLIP_INTER_AUDIO_PAUSE_MS=1500


# --- Backup ---
# Environment name used as a prefix for S3 object keys (e.g. "prod", "staging").
ENVIRONMENT=
# S3-compatible object store for backup storage.
S3_BUCKET=
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
# S3_REGION=    # optional; required by some providers
# BACKUP_INACTIVITY_MINUTES=15
# BACKUP_POLL_SECONDS=60


# --- Network ---
# APP_PORT=5001
# COMPOSE_PROJECT_NAME=vibevocab


# --- Storage directories ---
# Override these to store data outside the project directory.
# Paths can be absolute or relative to this file's directory (src/docker/).
# DB_DIR=../../db
# WEB_DIR=../../src/web
